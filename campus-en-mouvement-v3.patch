--- a/src/components/OfflineNotice.jsx	1970-01-01 01:00:00.000000000 +0100
+++ b/src/components/OfflineNotice.jsx	2026-10-28 09:13:38.000000000 +0100
@@ -0,0 +1,33 @@
+import { useSyncExternalStore } from 'react'
+import { WifiOff } from 'lucide-react'
+
+function subscribe(callback) {
+  window.addEventListener('online', callback)
+  window.addEventListener('offline', callback)
+  return () => {
+    window.removeEventListener('online', callback)
+    window.removeEventListener('offline', callback)
+  }
+}
+
+// Bandeau affiché tant que l'appareil n'a plus de connexion
+export default function OfflineNotice() {
+  const online = useSyncExternalStore(
+    subscribe,
+    () => navigator.onLine,
+    () => true,
+  )
+
+  if (online) return null
+
+  return (
+    <p
+      role="status"
+      className="mb-4 flex items-start gap-2 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900"
+    >
+      <WifiOff size={16} className="mt-0.5 shrink-0" />
+      Hors connexion : vous voyez les dernières données chargées. Les messages et réservations
+      reprendront dès que le réseau revient.
+    </p>
+  )
+}
diff -ruN '--exclude=package-lock.json' a/src/components/PushToggle.jsx b/src/components/PushToggle.jsx
--- a/src/components/PushToggle.jsx	1970-01-01 01:00:00.000000000 +0100
+++ b/src/components/PushToggle.jsx	2026-10-28 09:13:44.000000000 +0100
@@ -0,0 +1,75 @@
+import { useEffect, useState } from 'react'
+import { Bell, BellOff } from 'lucide-react'
+import { disablePush, enablePush, getPushState } from '../lib/push'
+
+// Active / désactive les notifications push sur cet appareil
+export default function PushToggle() {
+  const [state, setState] = useState(null) // null = vérification en cours
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState(null)
+
+  useEffect(() => {
+    let active = true
+    getPushState().then((next) => {
+      if (active) setState(next)
+    })
+    return () => {
+      active = false
+    }
+  }, [])
+
+  async function toggle() {
+    setBusy(true)
+    setError(null)
+    try {
+      if (state === 'subscribed') await disablePush()
+      else await enablePush()
+      setState(await getPushState())
+    } catch (err) {
+      setError(err.message)
+      setState(await getPushState())
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  if (state === null) return null
+
+  const hint = {
+    unsupported:
+      'Votre navigateur ne gère pas les notifications. Sur iPhone, installez d’abord l’application sur l’écran d’accueil.',
+    unconfigured: 'Les notifications ne sont pas encore configurées sur ce site.',
+    denied: 'Notifications bloquées : autorisez-les dans les réglages du navigateur, puis revenez ici.',
+    idle: 'Soyez prévenu d’un nouveau message, d’un passager ou d’un désistement, même application fermée.',
+    subscribed: 'Activées sur cet appareil.',
+  }[state]
+
+  const disabled = busy || ['unsupported', 'unconfigured', 'denied'].includes(state)
+
+  return (
+    <section className="border-pine-100 mt-6 rounded-2xl border bg-white p-4">
+      <h2 className="font-medium">Notifications</h2>
+      <p className="text-pine-700 mt-1 text-sm">{hint}</p>
+
+      {error && <p className="mt-3 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800">{error}</p>}
+
+      <button
+        type="button"
+        onClick={toggle}
+        disabled={disabled}
+        className={`mt-4 flex w-full items-center justify-center gap-2 rounded-xl py-3.5 font-medium disabled:opacity-50 ${
+          state === 'subscribed'
+            ? 'border-pine-100 border bg-white'
+            : 'bg-pine-900 text-white'
+        }`}
+      >
+        {state === 'subscribed' ? <BellOff size={18} /> : <Bell size={18} />}
+        {busy
+          ? 'Un instant…'
+          : state === 'subscribed'
+            ? 'Désactiver les notifications'
+            : 'Activer les notifications'}
+      </button>
+    </section>
+  )
+}
diff -ruN '--exclude=package-lock.json' a/src/components/RecurrenceFields.jsx b/src/components/RecurrenceFields.jsx
--- a/src/components/RecurrenceFields.jsx	1970-01-01 01:00:00.000000000 +0100
+++ b/src/components/RecurrenceFields.jsx	2026-10-28 20:41:32.000000000 +0100
@@ -0,0 +1,81 @@
+import { Repeat } from 'lucide-react'
+import { MAX_RECURRENCE_DAYS, addDays } from '../lib/recurrence'
+
+// Jours au format ISO : 1 = lundi … 7 = dimanche (identique à la fonction SQL)
+const DAYS = [
+  { id: 1, label: 'Lun' },
+  { id: 2, label: 'Mar' },
+  { id: 3, label: 'Mer' },
+  { id: 4, label: 'Jeu' },
+  { id: 5, label: 'Ven' },
+  { id: 6, label: 'Sam' },
+  { id: 7, label: 'Dim' },
+]
+
+// value : { enabled, days, endDate } — startDate : date du premier trajet ("AAAA-MM-JJ")
+export default function RecurrenceFields({ value, onChange, startDate }) {
+  const set = (patch) => onChange({ ...value, ...patch })
+
+  const toggleDay = (id) =>
+    set({
+      days: value.days.includes(id) ? value.days.filter((d) => d !== id) : [...value.days, id],
+    })
+
+  return (
+    <div className="border-pine-100 rounded-xl border p-3">
+      <label className="flex cursor-pointer items-center gap-2 text-sm font-medium">
+        <input
+          type="checkbox"
+          checked={value.enabled}
+          onChange={(e) => set({ enabled: e.target.checked })}
+          className="accent-pine-500 h-4 w-4"
+        />
+        <Repeat size={16} className="text-pine-500" />
+        Répéter chaque semaine (emploi du temps)
+      </label>
+
+      {value.enabled && (
+        <div className="mt-3 space-y-3">
+          <div>
+            <span className="text-pine-700 mb-1.5 block text-xs">Jours du trajet</span>
+            <div className="flex flex-wrap gap-1.5">
+              {DAYS.map((day) => (
+                <button
+                  key={day.id}
+                  type="button"
+                  onClick={() => toggleDay(day.id)}
+                  aria-pressed={value.days.includes(day.id)}
+                  className={`rounded-full border px-3 py-1 text-sm ${
+                    value.days.includes(day.id)
+                      ? 'bg-pine-900 border-pine-900 text-white'
+                      : 'border-pine-100 text-pine-700 bg-white'
+                  }`}
+                >
+                  {day.label}
+                </button>
+              ))}
+            </div>
+          </div>
+
+          <label className="block">
+            <span className="text-pine-700 mb-1 block text-xs">Répéter jusqu’au</span>
+            <input
+              type="date"
+              required
+              value={value.endDate}
+              min={startDate || undefined}
+              max={startDate ? addDays(startDate, MAX_RECURRENCE_DAYS) : undefined}
+              onChange={(e) => set({ endDate: e.target.value })}
+              className="border-pine-100 focus:border-pine-500 w-full rounded-xl border bg-white px-3 py-3 outline-none"
+            />
+          </label>
+
+          <p className="text-pine-500 text-xs">
+            Un trajet est créé pour chaque jour choisi, jusqu’à 6 mois. Vous pourrez annuler toute la
+            série depuis le détail d’un trajet.
+          </p>
+        </div>
+      )}
+    </div>
+  )
+}
